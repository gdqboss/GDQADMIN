                multiple
                @change="handleImageUpload"
                class="w-full text-xs sm:text-sm"
              >
              <div v-if="form.images && form.images.length > 0" class="mt-3 grid grid-cols-3 sm:grid-cols-4 gap-2">
                <div v-for="(img, idx) in form.images" :key="idx" class="relative">
                  <img :src="img" class="w-full h-16 sm:h-20 object-cover rounded">
                  <button
                    @click="removeImage(idx)"
                    class="absolute top-1 right-1 bg-red-500 text-white rounded-full w-5 h-5 flex items-center justify-center text-xs hover:bg-red-600"
                  >×</button>
                </div>
              </div>
            </div>
          </div>

          <!-- 定位 -->
          <div>
            <label class="block text-sm font-medium mb-2">定位</label>
            <div class="border rounded p-3">
              <button
                @click="getLocation"
                class="w-full sm:w-auto px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 text-sm flex items-center justify-center gap-2"
              >
                <span class="material-symbols-outlined text-sm">location_on</span>
                {{ form.location ? '重新定位' : '获取当前位置' }}
              </button>
              <div v-if="form.location" class="mt-2 text-sm text-gray-700">
                <p class="break-all">📍 {{ form.location }}</p>
                <p class="text-xs text-gray-500">经度: {{ form.gps_lng }}, 纬度: {{ form.gps_lat }}</p>
              </div>
            </div>
          </div>

          <!-- 参与人员 -->
          <div>
            <label class="block text-sm font-medium mb-2">参与人员（下级）</label>
            <div class="border rounded p-3">
              <button
