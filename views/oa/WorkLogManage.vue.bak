                >
                  <span class="truncate max-w-[100px] sm:max-w-none">{{ user.name }}</span>
                  <button @click="removeParticipant(user.id)" class="hover:text-green-900">
                    <span class="material-symbols-outlined text-sm">close</span>
                  </button>
                </span>
              </div>
              <div v-else class="mt-2 text-sm text-gray-500">
                未选择参与人员
              </div>
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium mb-2">{{ t('oa.recipients') }}</label>
            <div class="border rounded p-3">
              <div class="flex flex-col sm:flex-row gap-2 mb-2">
                <input
                  v-model="recipientSearch"
                  type="text"
                  :placeholder="t('oa.searchUser')"
                  class="flex-1 border rounded px-3 py-2 text-sm"
                >
                <button @click="showUserSelector = true" class="w-full sm:w-auto px-3 py-2 bg-gray-100 rounded hover:bg-gray-200 text-sm whitespace-nowrap">
                  {{ t('oa.selectUsers') }}
                </button>
              </div>
              <div v-if="selectedRecipients.length > 0" class="flex flex-wrap gap-2">
                <span
                  v-for="user in selectedRecipients"
                  :key="user.id"
                  class="px-2 sm:px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-xs sm:text-sm flex items-center gap-1"
                >
                  <span class="truncate max-w-[100px] sm:max-w-none">{{ user.name }}</span>
                  <button @click="removeRecipient(user.id)" class="hover:text-blue-900">
                    <span class="material-symbols-outlined text-sm">close</span>
                  </button>
                </span>
              </div>
              <div v-else class="text-sm text-gray-500">
                {{ t('oa.selectRecipients') }}
              </div>
            </div>
          </div>
        </div>

        <div class="mt-4 sm:mt-6 flex flex-col sm:flex-row gap-2 sm:gap-3">
          <button @click="showWriteLog = false" class="w-full sm:w-auto px-4 py-2 border rounded hover:bg-gray-50 text-sm sm:text-base">
            {{ t('common.cancel') }}
          </button>
          <button @click="submitLog" class="w-full sm:flex-1 px-4 py-2 bg-primary text-white rounded hover:bg-primary-dark text-sm sm:text-base">
            {{ t('common.submit') }}
          </button>
        </div>
      </div>
    </div>

    <!-- User Selector Modal -->
    <div v-if="showUserSelector" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4" @click="showUserSelector = false">
      <div class="bg-white rounded-lg p-4 sm:p-6 w-full max-w-2xl max-h-[80vh] overflow-y-auto" @click.stop>
        <h3 class="text-lg sm:text-xl font-bold mb-4">{{ t('oa.selectUsers') }}</h3>
        <input
          v-model="userSearchKeyword"
          type="text"
          :placeholder="t('oa.searchUser')"
          class="w-full border rounded px-3 py-2 mb-4 text-sm sm:text-base"
        >
        <div class="space-y-2 max-h-96 overflow-y-auto">
          <label
            v-for="user in filteredUsers"
            :key="user.id"
            class="flex items-center gap-2 p-2 sm:p-3 hover:bg-gray-50 rounded cursor-pointer"
          >
            <input
              type="checkbox"
              :checked="isRecipientSelected(user.id)"
              @change="toggleRecipient(user)"
              class="w-4 h-4 flex-shrink-0"
            >
            <span class="text-sm sm:text-base truncate">{{ user.name }} - {{ user.department || t('common.unknown') }}</span>
          </label>
        </div>
        <div class="mt-4 flex flex-col sm:flex-row justify-between items-center gap-2">
          <span class="text-sm text-gray-600">{{ t('oa.selectedCount') }}: {{ selectedRecipients.length }}</span>
          <button @click="showUserSelector = false" class="w-full sm:w-auto px-4 py-2 bg-primary text-white rounded hover:bg-primary-dark text-sm sm:text-base">
            {{ t('common.confirm') }}
          </button>
        </div>
      </div>
    </div>

    <!-- Participant Selector Modal -->
    <div v-if="showParticipantSelector" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4" @click="showParticipantSelector = false">
      <div class="bg-white rounded-lg p-4 sm:p-6 w-full max-w-2xl max-h-[80vh] overflow-y-auto" @click.stop>
