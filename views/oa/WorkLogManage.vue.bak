        <span>{{ t('oa.writeLog') }}</span>
      </button>
    </div>

    <!-- Tabs -->
    <div class="bg-white rounded-lg shadow mb-4 sm:mb-6">
      <div class="flex border-b overflow-x-auto">
        <button
          v-for="tab in tabs"
          :key="tab.value"
          @click="currentTab = tab.value"
          :class="[
            'px-4 sm:px-6 py-3 font-medium transition-colors whitespace-nowrap text-sm sm:text-base',
            currentTab === tab.value
              ? 'text-primary border-b-2 border-primary'
              : 'text-gray-600 hover:text-gray-800'
          ]"
        >
          {{ tab.label }}
        </button>
      </div>

      <!-- Filters -->
      <div class="p-3 sm:p-4 flex gap-2 sm:gap-4 flex-wrap">
        <input v-model="filters.start_date" type="date" class="flex-1 min-w-[120px] border rounded px-2 sm:px-3 py-2 text-sm">
        <input v-model="filters.end_date" type="date" class="flex-1 min-w-[120px] border rounded px-2 sm:px-3 py-2 text-sm">
        <button @click="loadLogs" class="px-3 sm:px-4 py-2 bg-primary text-white rounded hover:bg-primary-dark text-sm whitespace-nowrap">{{ t('common.search') }}</button>
      </div>
    </div>

    <!-- Work Logs List -->
    <div class="space-y-3 sm:space-y-4">
