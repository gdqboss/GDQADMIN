                class="w-full sm:w-auto px-3 py-2 bg-gray-100 rounded hover:bg-gray-200 text-sm"
              >
                选择参与人员
              </button>
              <div v-if="selectedParticipants.length > 0" class="mt-2 flex flex-wrap gap-2">
                <span
