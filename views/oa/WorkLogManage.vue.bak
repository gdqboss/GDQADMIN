      >
        <div class="flex justify-between items-start mb-3 sm:mb-4">
          <div class="flex-1 min-w-0">
            <h3 class="font-semibold text-base sm:text-lg truncate">{{ log.user_name }}</h3>
            <p class="text-xs sm:text-sm text-gray-600 truncate">{{ log.date }} · {{ log.department_name || log.department || t('common.unknown') }}</p>
          </div>
          <div class="flex gap-2 sm:gap-3 text-xs sm:text-sm text-gray-500 ml-2">
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-sm sm:text-base">visibility</span>
              <span class="hidden sm:inline">{{ log.read_count || 0 }}</span>
            </span>
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-sm sm:text-base">chat_bubble</span>
              <span class="hidden sm:inline">{{ log.comment_count || 0 }}</span>
            </span>
            <span class="flex items-center gap-1">
              <span class="material-symbols-outlined text-sm sm:text-base">thumb_up</span>
              <span class="hidden sm:inline">{{ log.like_count || 0 }}</span>
            </span>
          </div>
        </div>
        <div class="text-sm text-gray-700 line-clamp-3">
          {{ getLogSummary(log.content) }}
        </div>
        <div class="mt-2 sm:mt-3 flex items-center gap-2">
          <span v-if="currentTab === 'received' && !log.has_read" class="px-2 py-1 bg-red-100 text-red-700 text-xs rounded">
            {{ t('oa.unread') }}
          </span>
          <span v-else-if="currentTab === 'received' && log.has_read" class="px-2 py-1 bg-green-100 text-green-700 text-xs rounded">
            {{ t('oa.read') }}
          </span>
        </div>
      </div>
    </div>

    <!-- Pagination -->
    <div v-if="logs.total > logs.list.length" class="mt-6 flex justify-center">
      <button
