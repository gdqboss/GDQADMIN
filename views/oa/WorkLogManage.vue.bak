          </label>
        </div>
        <div class="mt-4 flex flex-col sm:flex-row justify-between items-center gap-2">
          <span class="text-sm text-gray-600">已选择: {{ selectedParticipants.length }}</span>
          <button @click="showParticipantSelector = false" class="w-full sm:w-auto px-4 py-2 bg-primary text-white rounded hover:bg-primary-dark text-sm sm:text-base">
            {{ t('common.confirm') }}
          </button>
        </div>
      </div>
    </div>

    <!-- Log Detail Modal -->
    <div v-if="showDetailModal && currentLog" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4" @click="showDetailModal = false">
      <div class="bg-white rounded-lg p-4 sm:p-6 w-full max-w-4xl max-h-[90vh] overflow-y-auto" @click.stop>
        <div class="flex justify-between items-start mb-4 sm:mb-6">
          <div class="flex-1 min-w-0">
            <h2 class="text-xl sm:text-2xl font-bold truncate">{{ currentLog.user_name }}</h2>
            <p class="text-sm sm:text-base text-gray-600 truncate">{{ currentLog.date }} · {{ currentLog.department_name || currentLog.department }}</p>
          </div>
          <button @click="showDetailModal = false" class="text-gray-500 hover:text-gray-700 ml-2 flex-shrink-0">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>

        <!-- Log Content -->
        <div class="mb-4 sm:mb-6 p-3 sm:p-4 bg-gray-50 rounded-lg">
          <div v-for="(value, key) in parseContent(currentLog.content)" :key="key" class="mb-3">
            <h4 class="font-medium text-gray-700 mb-1 text-sm sm:text-base">{{ key }}</h4>
            <p class="text-gray-800 whitespace-pre-line text-sm sm:text-base">{{ value }}</p>
          </div>
        </div>

        <!-- Interaction Stats -->
        <div class="flex flex-wrap gap-3 sm:gap-6 mb-4 sm:mb-6 pb-4 sm:pb-6 border-b">
          <button
            @click="toggleReadList"
            class="flex items-center gap-1 sm:gap-2 text-gray-700 hover:text-primary text-sm sm:text-base"
          >
            <span class="material-symbols-outlined text-base sm:text-xl">visibility</span>
            <span>{{ currentLog.read_count || 0 }} {{ t('oa.read') }}</span>
          </button>
          <button
            @click="toggleLike"
            :class="[
              'flex items-center gap-1 sm:gap-2 hover:text-primary text-sm sm:text-base',
              currentLog.has_liked ? 'text-red-500' : 'text-gray-700'
            ]"
          >
            <span class="material-symbols-outlined text-base sm:text-xl" :style="{ fontVariationSettings: currentLog.has_liked ? '\'FILL\' 1' : '\'FILL\' 0' }">
              thumb_up
            </span>
            <span>{{ currentLog.like_count || 0 }} {{ t('oa.like') }}</span>
          </button>
          <span class="flex items-center gap-1 sm:gap-2 text-gray-700 text-sm sm:text-base">
            <span class="material-symbols-outlined text-base sm:text-xl">chat_bubble</span>
            <span>{{ currentLog.comment_count || 0 }} {{ t('oa.comment') }}</span>
          </span>
        </div>

        <!-- Read List (Expandable) -->
        <div v-if="showReadList && currentLog.read_list" class="mb-4 sm:mb-6">
          <h3 class="font-semibold mb-3 flex items-center gap-2 text-sm sm:text-base">
            <span class="material-symbols-outlined">visibility</span>
            {{ t('oa.readList') }}
          </h3>
          <div class="space-y-2">
            <div v-for="read in currentLog.read_list" :key="read.user_id" class="flex items-center gap-2 sm:gap-3 p-2 sm:p-3 bg-green-50 border border-green-200 rounded">
              <div class="w-7 h-7 sm:w-8 sm:h-8 bg-green-600 text-white rounded-full flex items-center justify-center text-xs sm:text-sm flex-shrink-0">
                {{ read.user_name?.charAt(0) }}
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-medium text-sm sm:text-base truncate flex items-center gap-2">
                  {{ read.user_name }}
                  <span class="px-2 py-0.5 bg-green-600 text-white text-xs rounded">已阅读</span>
                </p>
                <p class="text-xs text-gray-600">{{ formatDateTime(read.read_at) }}</p>
              </div>
            </div>
          </div>

          <!-- Unread Recipients -->
          <div v-if="currentLog.recipient_list && currentLog.recipient_list.some(r => !r.has_read)" class="mt-4">
            <h4 class="text-xs sm:text-sm font-medium text-gray-600 mb-2">{{ t('oa.unreadBy') }}</h4>
            <div class="space-y-2">
              <div
                v-for="recipient in currentLog.recipient_list.filter(r => !r.has_read)"
                :key="recipient.id"
                class="flex items-center gap-2 sm:gap-3 p-2 bg-gray-50 border border-gray-200 rounded"
              >
                <div class="w-7 h-7 sm:w-8 sm:h-8 bg-gray-400 text-white rounded-full flex items-center justify-center text-xs sm:text-sm flex-shrink-0">
                  {{ recipient.name?.charAt(0) }}
                </div>
                <div class="flex-1 min-w-0">
                  <p class="font-medium text-sm sm:text-base truncate flex items-center gap-2">
                    {{ recipient.name }}
                    <span class="px-2 py-0.5 bg-gray-400 text-white text-xs rounded">未读</span>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Like List -->
        <div v-if="currentLog.like_list && currentLog.like_list.length > 0" class="mb-4 sm:mb-6">
          <h3 class="font-semibold mb-3 flex items-center gap-2 text-sm sm:text-base">
            <span class="material-symbols-outlined">thumb_up</span>
            {{ t('oa.likeList') }}
          </h3>
          <div class="flex flex-wrap gap-2">
            <span
              v-for="like in currentLog.like_list"
              :key="like.user_id"
              class="px-2 sm:px-3 py-1 bg-red-50 text-red-700 rounded-full text-xs sm:text-sm"
            >
              {{ like.user_name }}
            </span>
          </div>
        </div>

        <!-- Comments -->
        <div class="mb-4 sm:mb-6">
          <h3 class="font-semibold mb-3 flex items-center gap-2 text-sm sm:text-base">
            <span class="material-symbols-outlined">chat_bubble</span>
            {{ t('oa.commentList') }} ({{ currentLog.comment_count || 0 }})
          </h3>
          <div class="space-y-3 mb-4">
            <div v-if="!currentLog.comment_list || currentLog.comment_list.length === 0" class="text-gray-500 text-sm text-center py-4 bg-gray-50 rounded">
              {{ t('common.noData') }}
            </div>
            <div v-for="comment in currentLog.comment_list" :key="comment.id" class="flex gap-2 sm:gap-3 p-3 sm:p-4 bg-blue-50 border border-blue-200 rounded-lg">
              <div class="w-8 h-8 sm:w-10 sm:h-10 bg-blue-600 text-white rounded-full flex items-center justify-center text-sm sm:text-base font-semibold flex-shrink-0">
                {{ comment.user_name?.charAt(0) }}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span class="font-semibold text-sm sm:text-base text-blue-900">{{ comment.user_name }}</span>
                  <span class="px-2 py-0.5 bg-blue-600 text-white text-xs rounded">已评价</span>
                  <span class="text-xs text-gray-600">{{ formatDateTime(comment.created_at) }}</span>
                </div>
                <p class="text-gray-800 text-sm sm:text-base break-words bg-white p-2 rounded">{{ comment.content }}</p>
              </div>
            </div>
          </div>

          <!-- Add Comment -->
          <div class="flex flex-col sm:flex-row gap-2">
            <textarea
              v-model="newComment"
              :placeholder="t('oa.commentPlaceholder')"
              rows="3"
              class="flex-1 border-2 border-gray-300 focus:border-primary rounded px-3 py-2 text-sm sm:text-base"
            ></textarea>
            <button
              @click="submitComment"
              class="w-full sm:w-auto px-4 py-2 bg-primary text-white rounded hover:bg-primary-dark self-end text-sm sm:text-base whitespace-nowrap flex items-center justify-center gap-2"
            >
              <span class="material-symbols-outlined text-lg">send</span>
              <span>{{ t('oa.submitComment') }}</span>
            </button>
          </div>
        </div>

        <!-- Mark as Read Button (for received logs) -->
        <div v-if="currentTab === 'received' && !currentLog.has_read" class="mt-4 sm:mt-6">
          <button
            @click="markAsRead"
            class="w-full px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 text-sm sm:text-base"
          >
            {{ t('oa.markRead') }}
          </button>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, onMounted, computed } from 'vue'
import { useI18n } from 'vue-i18n'
import { useUserStore } from '../../stores/user'
import api from '../../services/api'

const { t } = useI18n()
const userStore = useUserStore()

const currentTab = ref('my')
const tabs = computed(() => {
  const baseTabs = [
    { value: 'my', label: t('oa.myLogs') },
    { value: 'received', label: t('oa.receivedLogs') }
  ]

  // Add subordinate tab if user is a leader (will be checked by backend)
  baseTabs.push({ value: 'subordinate', label: t('oa.subordinateLogs') })

  return baseTabs
})

const showWriteLog = ref(false)
const showDetailModal = ref(false)
const showUserSelector = ref(false)
const showParticipantSelector = ref(false)
const showReadList = ref(false)

const logs = ref({ list: [], total: 0, page: 1, size: 20 })
const filters = ref({
  start_date: '',
  end_date: ''
})

const templates = ref([])
const allUsers = ref([])
const selectedRecipients = ref([])
const selectedParticipants = ref([])
const recipientSearch = ref('')
const userSearchKeyword = ref('')
const participantSearchKeyword = ref('')

const form = ref({
  date: new Date().toISOString().split('T')[0],
  template_id: null,
  today: '',
  tomorrow: '',
  issues: '',
  templateContent: {},
  images: [],
  location: '',
  gps_lat: null,
  gps_lng: null
})

const currentTemplateFields = ref([])
const currentLog = ref(null)
const newComment = ref('')

onMounted(() => {
  loadLogs()
  loadTemplates()
  loadUsers()
})

async function loadLogs() {
  try {
    const params = {
      type: currentTab.value === 'my' ? undefined : currentTab.value,
      page: logs.value.page,
      size: logs.value.size,
      ...filters.value
    }
    const res = await api.get('/oa/work-logs', { params })
    if (res.code === 0) {
      if (logs.value.page === 1) {
        logs.value = res.data
      } else {
        logs.value.list.push(...res.data.list)
        logs.value.total = res.data.total
      }
    }
  } catch (err) {
    console.error('Failed to load work logs:', err)
  }
}

async function loadTemplates() {
  try {
    const res = await api.get('/oa/work-log-templates')
    if (res.code === 0) {
      templates.value = res.data
    }
  } catch (err) {
    console.error('Failed to load templates:', err)
  }
}

async function loadUsers() {
  try {
    const res = await api.get('/oa/employees', { params: { page: 1, size: 1000 } })
    if (res.code === 0) {
      allUsers.value = res.data.list
    }
  } catch (err) {
    console.error('Failed to load users:', err)
  }
}

function onTemplateChange() {
  if (form.value.template_id) {
    const template = templates.value.find(t => t.id === form.value.template_id)
    if (template && template.fields) {
      try {
        currentTemplateFields.value = JSON.parse(template.fields)
        form.value.templateContent = {}
      } catch (e) {
        console.error('Failed to parse template fields:', e)
      }
    }
  } else {
    currentTemplateFields.value = []
    form.value.templateContent = {}
  }
}

async function submitLog() {
  try {
    // Validation
    if (!form.value.date) {
      alert('请选择日期')
      return
    }

    let content = {}

    if (form.value.template_id) {
      content = form.value.templateContent
      // Check if template content is filled
      if (Object.keys(content).length === 0 || Object.values(content).every(v => !v || !v.trim())) {
        alert('请填写日志内容')
        return
      }
    } else {
      content = {
        '今日完成': form.value.today,
        '明日计划': form.value.tomorrow,
        '问题反馈': form.value.issues
      }
      // Check if at least one field is filled
      if (!form.value.today && !form.value.tomorrow && !form.value.issues) {
        alert('请至少填写一项内容')
        return
      }
    }

    const recipients = selectedRecipients.value.map(u => u.id)
    const participants = selectedParticipants.value.map(u => u.id)

    console.log('Submitting work log:', {
      date: form.value.date,
      template_id: form.value.template_id,
      content,
      recipients,
      participants
    })

    const res = await api.post('/oa/work-logs', {
      date: form.value.date,
      template_id: form.value.template_id,
      content,
      recipients: recipients.length > 0 ? recipients : null,
      attachments: form.value.images,
      location: form.value.location,
      gps_lat: form.value.gps_lat,
      gps_lng: form.value.gps_lng,
      participants: participants.length > 0 ? participants : null
    })

    if (res.code === 0) {
      alert('提交成功！')
      showWriteLog.value = false
      resetForm()
      logs.value.page = 1
      loadLogs()
    } else {
      alert(res.message || '提交失败')
    }
  } catch (err) {
    console.error('Submit error:', err)
    alert(err.response?.data?.message || err.message || '提交失败，请重试')
  }
}

function resetForm() {
  form.value = {
    date: new Date().toISOString().split('T')[0],
    template_id: null,
    today: '',
    tomorrow: '',
    issues: '',
    templateContent: {},
    images: [],
    location: '',
    gps_lat: null,
    gps_lng: null
  }
  selectedRecipients.value = []
  selectedParticipants.value = []
  currentTemplateFields.value = []
}

async function viewLogDetail(logId) {
  try {
    const res = await api.get(`/oa/work-logs/${logId}`)
    if (res.code === 0) {
      currentLog.value = res.data
      showDetailModal.value = true
      showReadList.value = false
    }
  } catch (err) {
    console.error('Failed to load log detail:', err)
  }
}

async function markAsRead() {
  try {
    await api.post(`/oa/work-logs/${currentLog.value.id}/read`)
    currentLog.value.has_read = true
    currentLog.value.read_count = (currentLog.value.read_count || 0) + 1

    // Reload logs to update the list
    logs.value.page = 1
    loadLogs()
  } catch (err) {
    console.error('Failed to mark as read:', err)
  }
}

async function toggleLike() {
  try {
    const res = await api.post(`/oa/work-logs/${currentLog.value.id}/like`)
    if (res.code === 0) {
      if (res.data.action === 'liked') {
        currentLog.value.has_liked = true
        currentLog.value.like_count = (currentLog.value.like_count || 0) + 1
      } else {
        currentLog.value.has_liked = false
        currentLog.value.like_count = Math.max(0, (currentLog.value.like_count || 0) - 1)
      }

      // Reload detail to get updated like list
      viewLogDetail(currentLog.value.id)
    }
  } catch (err) {
    console.error('Failed to toggle like:', err)
  }
}

async function submitComment() {
  if (!newComment.value.trim()) {
    alert('请输入评价内容')
    return
  }

  try {
    const res = await api.post(`/oa/work-logs/${currentLog.value.id}/comment`, {
      content: newComment.value
    })

    if (res.code === 0) {
      newComment.value = ''
      // Reload detail to get updated comments
      viewLogDetail(currentLog.value.id)
      alert('评价提交成功！')
    } else {
      alert(res.message || '评价提交失败')
    }
  } catch (err) {
    console.error('Failed to submit comment:', err)
    alert(err.response?.data?.message || '评价提交失败，请重试')
  }
}

function toggleReadList() {
  showReadList.value = !showReadList.value
}

function getLogSummary(content) {
  try {
    const parsed = typeof content === 'string' ? JSON.parse(content) : content
    const text = Object.values(parsed).join(' ')
    return text.length > 100 ? text.substring(0, 100) + '...' : text
  } catch {
    return ''
  }
}

function parseContent(content) {
  try {
    return typeof content === 'string' ? JSON.parse(content) : content
  } catch {
    return {}
  }
}

function formatDateTime(datetime) {
  if (!datetime) return ''
  return new Date(datetime).toLocaleString()
}

const filteredUsers = computed(() => {
  if (!userSearchKeyword.value) return allUsers.value
  const keyword = userSearchKeyword.value.toLowerCase()
  return allUsers.value.filter(u =>
    u.name.toLowerCase().includes(keyword) ||
    (u.department && u.department.toLowerCase().includes(keyword))
  )
})

function isRecipientSelected(userId) {
  return selectedRecipients.value.some(r => r.id === userId)
}

function toggleRecipient(user) {
  const index = selectedRecipients.value.findIndex(r => r.id === user.id)
  if (index > -1) {
    selectedRecipients.value.splice(index, 1)
  } else {
    selectedRecipients.value.push(user)
  }
}

function removeRecipient(userId) {
  const index = selectedRecipients.value.findIndex(r => r.id === userId)
  if (index > -1) {
    selectedRecipients.value.splice(index, 1)
  }
}

// 参与人员相关方法
const filteredParticipants = computed(() => {
  if (!participantSearchKeyword.value) {
    // 如果是管理员，显示所有用户；否则只显示下级
    if (userStore.userRole === 'admin') {
      return allUsers.value
    }
    // 这里应该过滤出下级，暂时返回所有用户
    return allUsers.value
  }
  const keyword = participantSearchKeyword.value.toLowerCase()
  const users = userStore.userRole === 'admin' ? allUsers.value : allUsers.value
  return users.filter(u =>
    u.name.toLowerCase().includes(keyword) ||
    (u.department && u.department.toLowerCase().includes(keyword))
  )
})

function isParticipantSelected(userId) {
  return selectedParticipants.value.some(p => p.id === userId)
}

function toggleParticipant(user) {
  const index = selectedParticipants.value.findIndex(p => p.id === user.id)
  if (index > -1) {
    selectedParticipants.value.splice(index, 1)
  } else {
    selectedParticipants.value.push(user)
  }
}

function removeParticipant(userId) {
  const index = selectedParticipants.value.findIndex(p => p.id === userId)
  if (index > -1) {
    selectedParticipants.value.splice(index, 1)
  }
}

// 图片上传
async function handleImageUpload(event) {
  const files = event.target.files
  if (!files || files.length === 0) return

  for (const file of files) {
    if (!file.type.startsWith('image/')) {
      alert('请选择图片文件')
      continue
    }

    // 转换为 base64
    const reader = new FileReader()
    reader.onload = (e) => {
      form.value.images.push(e.target.result)
    }
    reader.readAsDataURL(file)
  }
}

function removeImage(index) {
  form.value.images.splice(index, 1)
}

// 获取定位
function getLocation() {
  if (!navigator.geolocation) {
    alert('您的浏览器不支持定位功能')
    return
  }

  navigator.geolocation.getCurrentPosition(
    async (position) => {
      form.value.gps_lat = position.coords.latitude
      form.value.gps_lng = position.coords.longitude

      // 使用高德地图逆地理编码获取地址（需要配置高德API key）
      try {
        const response = await fetch(
          `https://restapi.amap.com/v3/geocode/regeo?key=YOUR_AMAP_KEY&location=${form.value.gps_lng},${form.value.gps_lat}`
        )
        const data = await response.json()
        if (data.status === '1' && data.regeocode) {
          form.value.location = data.regeocode.formatted_address
        } else {
          form.value.location = `${form.value.gps_lat.toFixed(6)}, ${form.value.gps_lng.toFixed(6)}`
        }
      } catch (err) {
        console.error('Failed to get address:', err)
        form.value.location = `${form.value.gps_lat.toFixed(6)}, ${form.value.gps_lng.toFixed(6)}`
      }
    },
    (error) => {
      console.error('Geolocation error:', error)
      alert('获取定位失败：' + error.message)
    }
  )
}

function loadMore() {
  logs.value.page++
  loadLogs()
}

// Watch tab changes
import { watch } from 'vue'
watch(currentTab, () => {
  logs.value.page = 1
  logs.value.list = []
  loadLogs()
})
</script>

<style scoped>
.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
