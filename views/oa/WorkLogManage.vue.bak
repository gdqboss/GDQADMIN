      >
        {{ t('common.loadMore') }}
      </button>
    </div>

    <!-- Write Log Modal -->
    <div v-if="showWriteLog" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4" @click="showWriteLog = false">
      <div class="bg-white rounded-lg p-4 sm:p-6 w-full max-w-3xl max-h-[90vh] overflow-y-auto" @click.stop>
        <h2 class="text-lg sm:text-xl font-bold mb-4">{{ t('oa.writeLog') }}</h2>
        <div class="space-y-3 sm:space-y-4">
          <div>
            <label class="block text-sm font-medium mb-1">{{ t('common.date') }}</label>
            <input v-model="form.date" type="date" class="w-full border rounded px-3 py-2 text-sm sm:text-base">
          </div>

          <div>
            <label class="block text-sm font-medium mb-1">{{ t('oa.templates') }}</label>
            <select v-model="form.template_id" @change="onTemplateChange" class="w-full border rounded px-3 py-2 text-sm sm:text-base">
              <option :value="null">{{ t('oa.useTemplate') }}</option>
              <option v-for="tpl in templates" :key="tpl.id" :value="tpl.id">{{ tpl.name }}</option>
            </select>
          </div>

          <div v-if="!form.template_id">
            <div class="mb-3 sm:mb-4">
              <label class="block text-sm font-medium mb-1">{{ t('oa.todayCompleted') }}</label>
              <textarea v-model="form.today" rows="4" class="w-full border rounded px-3 py-2 text-sm sm:text-base"></textarea>
            </div>
            <div class="mb-3 sm:mb-4">
              <label class="block text-sm font-medium mb-1">{{ t('oa.tomorrowPlan') }}</label>
              <textarea v-model="form.tomorrow" rows="4" class="w-full border rounded px-3 py-2 text-sm sm:text-base"></textarea>
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">{{ t('oa.issues') }}</label>
              <textarea v-model="form.issues" rows="3" class="w-full border rounded px-3 py-2 text-sm sm:text-base"></textarea>
            </div>
          </div>

          <div v-else>
            <div v-for="field in currentTemplateFields" :key="field.name" class="mb-3 sm:mb-4">
              <label class="block text-sm font-medium mb-1">{{ field.label }}</label>
              <textarea v-model="form.templateContent[field.name]" :rows="field.rows || 3" class="w-full border rounded px-3 py-2 text-sm sm:text-base"></textarea>
            </div>
          </div>

          <!-- 图片上传 -->
          <div>
            <label class="block text-sm font-medium mb-2">图片</label>
            <div class="border rounded p-3">
              <input
