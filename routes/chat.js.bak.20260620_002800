// Web Chat API proxy - 通过 Telegram Bot API 转发消息
import { Router } from 'express'

const router = Router()
const BOT_TOKEN = '8663024939:AAGn9t06-DXn6H6mF5IjsjxrqAr8G52UUn0'
const TG_API = 'https://api.telegram.org/bot' + BOT_TOKEN
const CHAT_ID = '861063885'

// 缓存最近的消息
let messageCache = []
let lastUpdateId = 0

// GET /api/chat/poll?chat_id=xxx&after=N - 轮询新消息
router.get('/poll', async (req, res) => {
  try {
    const resp = await fetch(TG_API + '/getUpdates?offset=' + (lastUpdateId + 1) + '&timeout=0&allowed_updates=["message"]')
    const data = await resp.json()

    const messages = []
    if (data.ok && data.result) {
      for (const update of data.result) {
        if (update.update_id > lastUpdateId) {
          lastUpdateId = update.update_id
        }
        const msg = update.message
        if (msg && msg.chat && String(msg.chat.id) === String(CHAT_ID)) {
          if (msg.text && !msg.text.startsWith('/')) {
            messages.push({
              id: msg.message_id,
              role: 'user',
              text: msg.text,
              time: msg.date
            })
          }
        }
        // 也捕获 bot 自己的回复
        if (update.channel_post && String(update.channel_post.chat.id) === String(CHAT_ID)) {
          messages.push({
            id: update.channel_post.message_id,
            role: 'assistant',
            text: update.channel_post.text || '(非文本消息)',
            time: update.channel_post.date
          })
        }
      }
    }

    res.json({ ok: true, messages })
  } catch (e) {
    res.json({ ok: false, error: e.message, messages: [] })
  }
})

// POST /api/chat/send - 发送消息到 Telegram
router.post('/send', async (req, res) => {
  try {
    const { chat_id, text } = req.body
    if (!text) return res.json({ ok: false, error: '消息不能为空' })

    const resp = await fetch(TG_API + '/sendMessage', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        chat_id: chat_id || CHAT_ID,
        text: text,
        disable_web_page_preview: true
      })
    })
    const data = await resp.json()
    res.json(data)
  } catch (e) {
    res.json({ ok: false, error: e.message })
  }
})

// GET /api/chat - 页面
router.get('/', (req, res) => {
  res.sendFile('/root/weapp-mall/chat.html', { root: '/' })
})

export default router
