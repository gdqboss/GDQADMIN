        }
        await conn.commit()
        return res.json({ code: 0, data: { id: result.insertId, record_no: recordNo }, message: 'ok' })
      } catch (err) {
        if (err.code === 'ER_DUP_ENTRY' && attempt < 2) continue
        throw err
      }
    }
  } catch (err) { await conn.rollback(); next(err) }
  finally { conn.release() }
})

