import express from 'express'
import { pool } from '../db/connection.js'
import { auth } from '../middleware/auth.js'
import crypto from 'crypto'

const router = express.Router()

// 百度翻译API
async function translateToEnglish(text) {
  if (!text) return ''
  
  const appId = '20260329000678901'  // 百度翻译AppID
  const appKey = '你自己的AppKey'  // 百度翻译密钥
  
  // 如果没有配置，返回原文
  if (appKey === '你自己的AppKey') {
    // 使用简单的本地翻译
    return localTranslate(text)
  }
  
  const salt = Date.now()
  const signStr = appId + text + salt + appKey
  const sign = crypto.createHash('md5').update(signStr).digest('hex')
  
  try {
    const url = `https://fanyi-api.baidu.com/api/trans/vip/translate?q=${encodeURIComponent(text)}&from=zh&to=en&appid=${appId}&salt=${salt}&sign=${sign}`
    const resp = await fetch(url)
    const data = await resp.json()
    if (data.trans_result && data.trans_result[0]) {
      return data.trans_result[0].dst
    }
  } catch (e) {
    console.log('翻译失败，使用本地翻译')
  }
  return localTranslate(text)
}

// 本地简单翻译
function localTranslate(text) {
  const dict = {
    '技术总监': 'Technical Director',
    '总经理': 'General Manager',
    '总监': 'Director',
    '经理': 'Manager',
    '主管': 'Supervisor',
    '员工': 'Staff',
    '创始人': 'Founder',
    '副总经理': 'Deputy General Manager',
    '销售总监': 'Sales Director',
    '财务总监': 'CFO',
    '行政总监': 'Admin Director',
    'CTO': 'CTO',
    'CEO': 'CEO',
    'COO': 'COO',
    '东莞彩美特': 'Dongguan CaiMeiTe',
    '技术': 'Technical',
    '团队': 'Team',
    '管理': 'Management',
    '系统': 'System',
    '开发': 'Development',
  }
  
  let result = text
  for (const [cn, en] of Object.entries(dict)) {
    result = result.replace(new RegExp(cn, 'g'), en)
  }
  return result
}

// 获取员工名片信息
router.get('/employees/:id/card', async (req, res, next) => {
  try {
    const { id } = req.params

    const [[employee]] = await pool.query(
      `SELECT id, name, email, phone, role, department, avatar, title, bio, wechat,
              card_bg, company_name, company_address, company_phone, images,
              status, created_at, employee_code
       FROM users WHERE id = ? AND status = 'active'`,
      [id]
    )

    if (!employee) {
      return res.status(404).json({ code: 404, message: '员工不存在' })
    }

    // 翻译字段
    const [bio_en, title_en, company_en] = await Promise.all([
      translateToEnglish(employee.bio),
      translateToEnglish(employee.title),
      translateToEnglish(employee.company_name)
    ])

    res.json({
      code: 0,
      data: {
        ...employee,
        bio_en,
        title_en,
        company_name_en: company_en,
        card_views: employee.card_views || 0,
        images: employee.images ? (typeof employee.images === 'string' ? JSON.parse(employee.images) : employee.images) : [],
        card_url: `https://wecom.gdqshop.cn/card.html?id=${id}`,
        can_edit: req.user && req.user.id == id
      },
      message: 'ok'
    })
  } catch (err) {
    next(err)
  }
})

// 更新名片信息
router.put('/employees/:id/card', auth, async (req, res, next) => {
  try {
    const { id } = req.params
    const userId = req.user.id

    if (userId != id && req.user.role !== 'admin') {
      return res.status(403).json({ code: 403, message: '无权修改' })
    }

    const { avatar, title, bio, wechat, card_bg, company_name, company_address, company_phone, images, bio_en, company_name_en, company_address_en } = req.body

    await pool.query(
      `UPDATE users SET 
        avatar = COALESCE(?, avatar),
        title = COALESCE(?, title),
        bio = COALESCE(?, bio),
        wechat = COALESCE(?, wechat),
        card_bg = COALESCE(?, card_bg),
        company_name = COALESCE(?, company_name),
        company_address = COALESCE(?, company_address),
        company_phone = COALESCE(?, company_phone)
       WHERE id = ?`,
      [avatar, title, bio, wechat, card_bg, company_name, company_address, company_phone, images ? JSON.stringify(images) : null, id]
    )

    res.json({ code: 0, message: '更新成功' })
  } catch (err) {
    next(err)
  }
})

// 浏览量+1
router.post('/employees/:id/view', async (req, res, next) => {
  try {
    const { id } = req.params
    await pool.query('UPDATE users SET card_views = card_views + 1 WHERE id = ?', [id])
    res.json({ code: 0, message: 'ok' })
  } catch (err) {
    next(err)
  }
})

export default router
